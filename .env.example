# Server-side only. NEVER prefix this with VITE_ — anything VITE_* is inlined
# into the browser bundle, and a Resend key grants full send access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form submissions are delivered.
CONTACT_TO=orjintaxavier@gmail.com

# Verified Resend sender. Until a domain is verified in Resend, leave this as
# onboarding@resend.dev (which can only deliver to your own account address).
CONTACT_FROM=Portfolio Contact <onboarding@resend.dev>
